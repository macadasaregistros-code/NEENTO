NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional compatibility alias if you use the older anon key name.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-only. Used by /api/story/generate to create stories with Gemini.
GEMINI_API_KEY=your-google-ai-studio-api-key

# Optional. Defaults to gemini-2.5-flash-lite.
# GEMINI_STORY_MODEL=gemini-2.5-flash-lite
